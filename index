<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order Desk — WhatsApp Bot Console (Live)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0D1917; --ink-mid:#142521; --ink-hi:#1B2F2A;
    --paper:#F5F1E6; --paper-dim:#B9C4BE;
    --jade:#2FA98C; --jade-deep:#0B4F43;
    --amber:#E2A63B; --mint:#4FAF6D; --coral:#E1604A;
    --line:rgba(245,241,230,0.09); --line-hi:rgba(245,241,230,0.16);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--ink);color:var(--paper);font-family:'Inter',sans-serif;min-height:100vh;-webkit-font-smoothing:antialiased;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  .shell{display:grid;grid-template-columns:76px 1fr;min-height:100vh;}
  .rail{background:var(--ink-mid);border-right:1px solid var(--line);display:flex;flex-direction:column;align-items:center;padding:22px 0;gap:28px;}
  .rail-logo{width:38px;height:38px;border-radius:10px;background:linear-gradient(155deg,var(--jade),var(--jade-deep));display:flex;align-items:center;justify-content:center;font-family:'Sora',sans-serif;font-weight:700;font-size:15px;color:var(--paper);}
  .rail-icons{display:flex;flex-direction:column;gap:6px;margin-top:8px;}
  .rail-ic{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--paper-dim);cursor:pointer;font-size:17px;transition:background .15s,color .15s;}
  .rail-ic.active{background:var(--ink-hi);color:var(--jade);}
  .rail-ic:hover{background:var(--ink-hi);color:var(--paper);}
  .rail-bottom{margin-top:auto;color:var(--paper-dim);font-size:11px;text-align:center;line-height:1.5;}
  .rail-pulse{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 0 rgba(79,175,109,.6);animation:pulse 2s infinite;}
  @keyframes pulse{0%{box-shadow:0 0 0 0 rgba(79,175,109,.55);}70%{box-shadow:0 0 0 7px rgba(79,175,109,0);}100%{box-shadow:0 0 0 0 rgba(79,175,109,0);}}
  .main{padding:26px 34px 50px;max-width:1400px;}
  header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:26px;flex-wrap:wrap;gap:16px;}
  .h-title{font-family:'Sora',sans-serif;font-weight:700;font-size:26px;letter-spacing:-0.02em;}
  .h-sub{color:var(--paper-dim);font-size:13.5px;margin-top:4px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
  .status-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(79,175,109,.12);color:var(--mint);border:1px solid rgba(79,175,109,.3);padding:3px 10px 3px 8px;border-radius:100px;font-size:11.5px;font-weight:600;font-family:'IBM Plex Mono',monospace;letter-spacing:.02em;}
  .status-chip.err{background:rgba(225,96,74,.12);color:var(--coral);border-color:rgba(225,96,74,.3);}
  .status-chip.warn{background:rgba(226,166,59,.12);color:var(--amber);border-color:rgba(226,166,59,.3);}
  .status-dot{width:6px;height:6px;border-radius:50%;background:currentColor;animation:pulse 2s infinite;}
  .h-actions{display:flex;gap:10px;align-items:center;}
  .search{background:var(--ink-mid);border:1px solid var(--line);border-radius:9px;padding:9px 14px;color:var(--paper);font-size:13px;width:220px;font-family:'Inter';}
  .search::placeholder{color:var(--paper-dim);}
  .btn-primary{background:var(--jade);color:var(--ink);border:none;border-radius:9px;padding:9px 16px;font-weight:600;font-size:13px;cursor:pointer;font-family:'Inter';transition:filter .15s;}
  .btn-primary:hover{filter:brightness(1.08);}
  .btn-primary:disabled{opacity:.5;cursor:default;}
  .ticker{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-bottom:26px;background:var(--ink-mid);}
  .tick{padding:18px 22px;border-right:1px solid var(--line);position:relative;}
  .tick:last-child{border-right:none;}
  .tick-label{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--paper-dim);font-family:'IBM Plex Mono',monospace;margin-bottom:8px;}
  .tick-value{font-family:'Sora',sans-serif;font-weight:700;font-size:27px;letter-spacing:-0.02em;}
  .tick-delta{font-size:12px;margin-top:5px;font-family:'IBM Plex Mono',monospace;color:var(--paper-dim);}
  .tick-accent{position:absolute;left:0;top:0;bottom:0;width:3px;}
  .tick:nth-child(1) .tick-accent{background:var(--jade);}
  .tick:nth-child(2) .tick-accent{background:var(--mint);}
  .tick:nth-child(3) .tick-accent{background:var(--amber);}
  .tick:nth-child(4) .tick-accent{background:var(--coral);}
  .body-grid{display:grid;grid-template-columns:1fr 360px;gap:22px;align-items:start;}
  .panel{background:var(--ink-mid);border:1px solid var(--line);border-radius:14px;overflow:hidden;}
  .panel-head{display:flex;justify-content:space-between;align-items:center;padding:18px 22px 0px;}
  .panel-title{font-family:'Sora',sans-serif;font-weight:600;font-size:16px;}
  .tabs{display:flex;gap:4px;padding:16px 22px 14px;border-bottom:1px solid var(--line);flex-wrap:wrap;}
  .tab{padding:6px 13px;border-radius:100px;font-size:12.5px;color:var(--paper-dim);cursor:pointer;font-weight:500;transition:all .15s;font-family:'Inter';border:1px solid transparent;}
  .tab.active{background:var(--ink-hi);color:var(--paper);border-color:var(--line-hi);}
  .tab:hover:not(.active){color:var(--paper);}
  .ledger{padding:6px 10px 14px;min-height:120px;}
  .row{display:grid;grid-template-columns:34px 1fr 130px 90px 96px;align-items:center;gap:14px;padding:13px 12px;border-radius:10px;transition:background .15s;}
  .row:hover{background:var(--ink-hi);}
  .row + .row{border-top:1px dashed var(--line);}
  .avatar{width:34px;height:34px;border-radius:9px;background:var(--ink-hi);display:flex;align-items:center;justify-content:center;font-family:'Sora';font-weight:700;font-size:12px;color:var(--jade);}
  .cust{display:flex;flex-direction:column;gap:2px;min-width:0;}
  .cust-name{font-size:13.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .cust-meta{font-size:11.5px;color:var(--paper-dim);font-family:'IBM Plex Mono',monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .amount{font-family:'IBM Plex Mono',monospace;font-size:13.5px;font-weight:600;text-align:right;}
  .pill{font-size:11px;font-weight:600;padding:4px 9px;border-radius:100px;text-align:center;font-family:'IBM Plex Mono',monospace;letter-spacing:.02em;white-space:nowrap;}
  .pill-paid{background:rgba(79,175,109,.14);color:var(--mint);}
  .pill-pending{background:rgba(226,166,59,.14);color:var(--amber);}
  .pill-processing{background:rgba(47,169,140,.14);color:var(--jade);}
  .pill-failed{background:rgba(225,96,74,.14);color:var(--coral);}
  .id-badge{font-size:11px;color:var(--paper-dim);font-family:'IBM Plex Mono',monospace;text-align:right;}
  .ledger-empty, .ledger-loading{padding:40px 20px;text-align:center;color:var(--paper-dim);font-size:13px;}
  .ledger-error{padding:20px;text-align:left;color:var(--coral);font-size:12.5px;font-family:'IBM Plex Mono',monospace;background:rgba(225,96,74,.08);border-radius:10px;margin:10px;line-height:1.6;white-space:pre-wrap;}
  .feed-head{padding:18px 22px 14px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;}
  .feed-title{font-family:'Sora';font-weight:600;font-size:16px;display:flex;align-items:center;gap:8px;}
  .feed-list{padding:16px 18px;display:flex;flex-direction:column;gap:2px;max-height:640px;overflow-y:auto;}
  .fe{display:flex;gap:10px;padding:10px 6px;position:relative;}
  .fe-rail{display:flex;flex-direction:column;align-items:center;width:20px;flex-shrink:0;}
  .fe-dot{width:9px;height:9px;border-radius:50%;margin-top:4px;flex-shrink:0;}
  .fe-line{width:1px;flex:1;background:var(--line);margin-top:4px;}
  .fe-body{flex:1;padding-bottom:2px;}
  .fe-bubble{background:var(--ink-hi);border:1px solid var(--line);border-radius:10px 10px 10px 3px;padding:9px 12px;font-size:12.5px;line-height:1.5;}
  .fe-bubble b{color:var(--paper);}
  .fe-meta{display:flex;justify-content:space-between;margin-top:5px;padding:0 2px;}
  .fe-name{font-size:11px;color:var(--jade);font-weight:600;}
  .fe-time{font-size:10.5px;color:var(--paper-dim);font-family:'IBM Plex Mono',monospace;}
  ::-webkit-scrollbar{width:8px;}
  ::-webkit-scrollbar-thumb{background:var(--ink-hi);border-radius:8px;}
  ::-webkit-scrollbar-track{background:transparent;}
  @media (max-width:980px){
    .shell{grid-template-columns:1fr;}
    .rail{flex-direction:row;justify-content:space-between;padding:14px 18px;}
    .rail-bottom{display:none;}
    .body-grid{grid-template-columns:1fr;}
    .ticker{grid-template-columns:repeat(2,1fr);}
    .row{grid-template-columns:30px 1fr 90px 74px;}
    .row .id-badge{display:none;}
    .main{padding:20px 16px 40px;}
  }
</style>
</head>
<body>
<div class="shell">
  <nav class="rail">
    <div class="rail-logo">OD</div>
    <div class="rail-icons">
      <div class="rail-ic active" title="Orders">☰</div>
      <div class="rail-ic" title="Payments">₹</div>
      <div class="rail-ic" title="Customers">◐</div>
      <div class="rail-ic" title="Bot flows">◆</div>
      <div class="rail-ic" title="Settings">⚙</div>
    </div>
    <div class="rail-bottom"><div class="rail-pulse" style="margin:0 auto 8px;"></div>LIVE</div>
  </nav>

  <main class="main">
    <header>
      <div>
        <div class="h-title">Order Desk</div>
        <div class="h-sub" id="connStatus">
          <span class="status-chip"><span class="status-dot"></span>Connecting to Supabase…</span>
        </div>
      </div>
      <div class="h-actions">
        <input class="search" id="searchBox" placeholder="Search phone or ref…">
        <button class="btn-primary" id="refreshBtn">Refresh</button>
      </div>
    </header>

    <section class="ticker">
      <div class="tick"><div class="tick-accent"></div>
        <div class="tick-label">Total orders loaded</div>
        <div class="tick-value mono" id="statOrders">—</div>
        <div class="tick-delta" id="statOrdersSub">most recent 100 rows</div>
      </div>
      <div class="tick"><div class="tick-accent"></div>
        <div class="tick-label">Completed / paid</div>
        <div class="tick-value mono" id="statPaid">—</div>
        <div class="tick-delta" id="paidRate">— of total</div>
      </div>
      <div class="tick"><div class="tick-accent"></div>
        <div class="tick-label">Pending / processing</div>
        <div class="tick-value mono" id="statPending">—</div>
        <div class="tick-delta" id="pendingRate">— of total</div>
      </div>
      <div class="tick"><div class="tick-accent"></div>
        <div class="tick-label">Revenue (completed)</div>
        <div class="tick-value mono" id="statRevenue">—</div>
        <div class="tick-delta">sum of amount, completed rows</div>
      </div>
    </section>

    <section class="body-grid">
      <div class="panel">
        <div class="panel-head">
          <div class="panel-title">Order ledger</div>
          <span class="mono" style="font-size:11.5px;color:var(--paper-dim);" id="rowCount"></span>
        </div>
        <div class="tabs">
          <div class="tab active" data-filter="all">All orders</div>
          <div class="tab" data-filter="completed">Completed</div>
          <div class="tab" data-filter="processing">Processing</div>
          <div class="tab" data-filter="pending">Pending</div>
        </div>
        <div class="ledger" id="ledger"><div class="ledger-loading">Loading orders from Supabase…</div></div>
      </div>

      <div class="panel">
        <div class="feed-head">
          <div class="feed-title"><span class="rail-pulse"></span>Bot activity</div>
          <span class="mono" style="font-size:11px;color:var(--paper-dim);">from orders table</span>
        </div>
        <div class="feed-list" id="feed"><div class="ledger-loading">Loading…</div></div>
      </div>
    </section>
  </main>
</div>

<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

// ---- Supabase connection ----
// These two placeholders get swapped for real values at build time on Render,
// using the environment variables you set in the Render dashboard.
const SUPABASE_URL = '__SUPABASE_URL__';
const SUPABASE_ANON_KEY = '__SUPABASE_ANON_KEY__';
const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

let orders = [];
let currentFilter = 'all';

function setConn(kind, msg){
  const cls = kind === 'ok' ? '' : kind === 'warn' ? 'warn' : 'err';
  document.getElementById('connStatus').innerHTML =
    `<span class="status-chip ${cls}"><span class="status-dot"></span>${msg}</span>`;
}

function pillClass(s){
  s = (s||'').toLowerCase();
  if(s==='completed') return 'pill-paid';
  if(s==='processing') return 'pill-processing';
  if(s==='pending') return 'pill-pending';
  return 'pill-failed';
}
function pillLabel(s){
  if(!s) return 'Unknown';
  return s.charAt(0).toUpperCase()+s.slice(1);
}
function initials(phone){
  const clean = (phone||'').replace(/\D/g,'');
  return clean ? clean.slice(-2) : '??';
}
function money(n){
  const v = Number(n)||0;
  return 'GH₵' + v.toLocaleString('en-GH',{minimumFractionDigits:2,maximumFractionDigits:2});
}

async function loadOrders(){
  document.getElementById('ledger').innerHTML = '<div class="ledger-loading">Loading orders from Supabase…</div>';
  document.getElementById('feed').innerHTML = '<div class="ledger-loading">Loading…</div>';
  document.getElementById('refreshBtn').disabled = true;

  const { data, error } = await supabase
    .from('orders')
    .select('*')
    .order('id', { ascending: false })
    .limit(100);

  document.getElementById('refreshBtn').disabled = false;

  if(error){
    setConn('err', 'Connection failed');
    document.getElementById('ledger').innerHTML = `<div class="ledger-error">Couldn't load orders from Supabase:\n${error.message}\n\nMost likely cause: Row Level Security is enabled on "orders" but there's no SELECT policy for the anon role yet. Run this in the Supabase SQL editor:\n\ncreate policy "Allow read for dashboard" on orders for select to anon using (true);</div>`;
    document.getElementById('feed').innerHTML = '';
    return;
  }

  orders = data || [];
  setConn('ok', `Connected — ${orders.length} orders loaded`);
  renderStats();
  renderLedger(currentFilter);
  renderFeed();
}

function renderStats(){
  const completed = orders.filter(o => (o.status||'').toLowerCase()==='completed');
  const pending = orders.filter(o => ['pending','processing'].includes((o.status||'').toLowerCase()));
  const revenue = completed.reduce((s,o)=> s + (Number(o.amount)||0), 0);

  document.getElementById('statOrders').textContent = orders.length;
  document.getElementById('statPaid').textContent = completed.length;
  document.getElementById('paidRate').textContent = orders.length ? Math.round(completed.length/orders.length*100)+"% of total" : "— of total";
  document.getElementById('statPending').textContent = pending.length;
  document.getElementById('pendingRate').textContent = orders.length ? Math.round(pending.length/orders.length*100)+"% of total" : "— of total";
  document.getElementById('statRevenue').textContent = money(revenue);
}

function renderLedger(filter){
  currentFilter = filter;
  const list = document.getElementById('ledger');
  const q = (document.getElementById('searchBox').value||'').toLowerCase().trim();

  let rows = orders.filter(o=>{
    if(filter !== 'all' && (o.status||'').toLowerCase() !== filter) return false;
    if(q){
      const hay = `${o.phone_number||''} ${o.whatsapp_phone||''} ${o.ref||''}`.toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });

  document.getElementById('rowCount').textContent = rows.length + " shown";

  if(rows.length===0){
    list.innerHTML = '<div class="ledger-empty">No orders match this filter — new bot orders will appear here as they land in Supabase.</div>';
    return;
  }

  list.innerHTML = rows.map(o=>{
    const phone = o.phone_number || o.whatsapp_phone || 'Unknown';
    const detail = [o.network, o.bundle ? o.bundle+'GB' : null, o.capacity ? o.capacity+'GB' : null].filter(Boolean).join(' · ');
    return `
    <div class="row">
      <div class="avatar">${initials(phone)}</div>
      <div class="cust">
        <div class="cust-name">${phone}</div>
        <div class="cust-meta">${o.ref || ('#'+o.id)}${detail ? ' · '+detail : ''}</div>
      </div>
      <div class="amount">${money(o.amount)}</div>
      <div><span class="pill ${pillClass(o.status)}">${pillLabel(o.status)}</span></div>
      <div class="id-badge">#${o.id}</div>
    </div>`;
  }).join('');
}

function renderFeed(){
  const list = document.getElementById('feed');
  const recent = orders.slice(0, 10);
  if(recent.length===0){
    list.innerHTML = '<div class="ledger-empty">No recent activity yet.</div>';
    return;
  }
  const colorFor = s => {
    s = (s||'').toLowerCase();
    if(s==='completed') return 'var(--mint)';
    if(s==='processing') return 'var(--jade)';
    if(s==='pending') return 'var(--amber)';
    return 'var(--coral)';
  };
  const textFor = o => {
    const phone = o.phone_number || o.whatsapp_phone || 'a customer';
    const s = (o.status||'').toLowerCase();
    if(s==='completed') return `Order <b>${o.ref || '#'+o.id}</b> completed for <b>${phone}</b> · ${money(o.amount)}`;
    if(s==='processing') return `Order <b>${o.ref || '#'+o.id}</b> is processing for <b>${phone}</b>`;
    if(s==='pending') return `Awaiting payment — <b>${o.ref || '#'+o.id}</b> from <b>${phone}</b>`;
    return `Order <b>${o.ref || '#'+o.id}</b> flagged: ${o.status||'unknown status'}`;
  };

  list.innerHTML = recent.map((o,i)=>`
    <div class="fe">
      <div class="fe-rail">
        <div class="fe-dot" style="background:${colorFor(o.status)}"></div>
        ${i<recent.length-1 ? '<div class="fe-line"></div>' : ''}
      </div>
      <div class="fe-body">
        <div class="fe-bubble">${textFor(o)}</div>
        <div class="fe-meta">
          <span class="fe-name">${o.network || 'Bot'}</span>
          <span class="fe-time">#${o.id}</span>
        </div>
      </div>
    </div>
  `).join('');
}

document.querySelectorAll('.tab').forEach(tab=>{
  tab.addEventListener('click', ()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    tab.classList.add('active');
    renderLedger(tab.dataset.filter);
  });
});
document.getElementById('searchBox').addEventListener('input', ()=> renderLedger(currentFilter));
document.getElementById('refreshBtn').addEventListener('click', loadOrders);

// Realtime: refresh when orders table changes
supabase
  .channel('orders-changes')
  .on('postgres_changes', { event: '*', schema: 'public', table: 'orders' }, () => {
    loadOrders();
  })
  .subscribe();

loadOrders();
</script>
</body>
</html>
